datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  USER
  ADMIN
}

enum Plan {
  FREE
  PRO
}

enum PricingType {
  FREE
  FREEMIUM
  PAID
  OPEN_SOURCE
}

enum ProjectType {
  SAAS
  WEBSITE
  AI
  MOBILE_APP
  WEB_APP
  ECOMMERCE
  MARKETPLACE
  TOOL
  WORDPRESS
  OPEN_SOURCE
  GAME
  AGENCY
  STARTUP
  OTHER
}

enum ProjectStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum CommentStatus {
  VISIBLE
  HIDDEN
}

enum ReportTarget {
  PROJECT
  COMMENT
}

enum ReportType {
  SPAM
  SCAM
  NSFW
  COPYRIGHT
  MALICIOUS
  FAKE_PROJECT
  OTHER
}

enum ReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

enum NotificationType {
  VOTE
  COMMENT
  FOLLOW
  PROJECT_APPROVED
  PROJECT_REJECTED
  TRENDING
  BOOST_ENDED
}

enum ProductKind {
  PRO_SUBSCRIPTION
  BOOST_7
  BOOST_30
  SPONSOR
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  PAST_DUE
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum OrderStatus {
  PENDING
  COMPLETED
  CANCELED
}

enum BoostStatus {
  ACTIVE
  ENDED
  CANCELED
}

enum FeaturedPlacement {
  HOME_HERO
  HOME_SECTION
  CATEGORY
}

enum AdminActionType {
  APPROVE
  REJECT
  SUSPEND
  DELETE
  FEATURE
  EDIT
  RESOLVE_REPORT
}

model User {
  id            String    @id @default(cuid(2))
  name          String?
  username      String    @unique
  email         String    @unique
  emailVerified DateTime?
  passwordHash  String?
  image         String?
  bio           String?
  website       String?
  role          Role      @default(USER)
  plan          Plan      @default(FREE)
  country       String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  projects      Project[]
  votes         ProjectVote[]
  favorites     Favorite[]
  comments      Comment[]
  following     Follow[]       @relation("UserFollowing")
  followers     Follow[]       @relation("UserFollowers")
  notifications Notification[]
  reports       Report[]
  adminActions  AdminAction[]
  subscriptions Subscription[]
  payments      Payment[]
  orders        Order[]

  @@index([role])
  @@index([plan])
}

model Account {
  id                String  @id @default(cuid(2))
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid(2))
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Category {
  id          String    @id @default(cuid(2))
  slug        String    @unique
  name        String
  icon        String
  description String?
  order       Int       @default(0)
  projects    Project[]

  @@index([order])
}

model Project {
  id              String        @id @default(cuid(2))
  slug            String        @unique
  name            String
  tagline         String
  description     String        @db.Text
  websiteUrl      String
  logoUrl         String?
  screenshots     Json          @default("[]")
  categoryId      String
  category        Category      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  subcategoryId   String?
  pricingType     PricingType   @default(FREE)
  projectType     ProjectType   @default(SAAS)
  country         String?
  launchDate      DateTime      @default(now())
  status          ProjectStatus @default(PENDING)
  rejectionReason String?
  featured        Boolean       @default(false)
  boostedUntil    DateTime?
  viewsCount      Int           @default(0)
  votesCount      Int           @default(0)
  favoritesCount  Int           @default(0)
  commentsCount   Int           @default(0)
  suspiciousAt    DateTime?
  isDemo          Boolean       @default(false)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  tags            ProjectTag[]
  technologies    ProjectTechnology[]
  votes           ProjectVote[]
  favorites       Favorite[]
  comments        Comment[]
  views           ProjectView[]
  clicks          WebsiteClick[]
  reports         Report[]
  boosts          Boost[]
  featuredPlacements FeaturedProject[]

  @@index([status, createdAt])
  @@index([userId])
  @@index([categoryId])
  @@index([votesCount])
  @@index([viewsCount])
  @@index([featured])
  @@index([boostedUntil])
}

model Tag {
  id       String       @id @default(cuid(2))
  slug     String       @unique
  name     String
  projects ProjectTag[]
}

model ProjectTag {
  id        String  @id @default(cuid(2))
  projectId String
  tagId     String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([projectId, tagId])
  @@index([projectId])
  @@index([tagId])
}

model Technology {
  id       String              @id @default(cuid(2))
  slug     String              @unique
  name     String
  projects ProjectTechnology[]
}

model ProjectTechnology {
  id           String     @id @default(cuid(2))
  projectId    String
  technologyId String
  project      Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  technology   Technology @relation(fields: [technologyId], references: [id], onDelete: Cascade)

  @@unique([projectId, technologyId])
  @@index([projectId])
  @@index([technologyId])
}

model ProjectVote {
  id        String   @id @default(cuid(2))
  projectId String
  userId    String
  createdAt DateTime @default(now())

  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
  @@index([createdAt])
  @@index([projectId, createdAt])
}

model Favorite {
  id        String   @id @default(cuid(2))
  projectId String
  userId    String
  createdAt DateTime @default(now())

  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
  @@index([createdAt])
  @@index([projectId, createdAt])
}

model Comment {
  id        String        @id @default(cuid(2))
  projectId String
  userId    String
  parentId  String?
  body      String        @db.Text
  editedAt  DateTime?
  status    CommentStatus @default(VISIBLE)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  project   Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent    Comment?      @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[]     @relation("CommentReplies")

  @@index([projectId, createdAt])
  @@index([userId])
  @@index([parentId])
}

model Follow {
  id          String   @id @default(cuid(2))
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower    User     @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
  @@index([createdAt])
}

model ProjectView {
  id        String   @id @default(cuid(2))
  projectId String
  visitorId String
  createdAt DateTime @default(now())

  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@index([visitorId, projectId, createdAt])
}

model WebsiteClick {
  id        String   @id @default(cuid(2))
  projectId String
  createdAt DateTime @default(now())

  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
}

model Report {
  id         String       @id @default(cuid(2))
  targetType ReportTarget
  targetId   String
  reporterId String
  reporter   User         @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  type       ReportType
  detail     String?      @db.Text
  status     ReportStatus @default(OPEN)
  createdAt  DateTime     @default(now())

  projectId  String?
  project    Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([targetType, targetId])
  @@index([status])
  @@index([reporterId])
  @@index([createdAt])
}

model Notification {
  id        String           @id @default(cuid(2))
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  actorId   String?
  projectId String?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId, createdAt])
  @@index([userId, read])
}

model Product {
  id          String         @id @default(cuid(2))
  slug        String         @unique
  name        String
  kind        ProductKind
  priceCents  Int
  currency    String         @default("USD")
  active      Boolean        @default(true)
  createdAt   DateTime       @default(now())

  subscriptions Subscription[]
  payments      Payment[]
  boosts        Boost[]
}

model Subscription {
  id               String             @id @default(cuid(2))
  userId           String
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId        String
  product          Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  status           SubscriptionStatus @default(ACTIVE)
  currentPeriodEnd DateTime
  provider         String?
  providerRef      String?            @unique
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([userId])
}

model Payment {
  id          String        @id @default(cuid(2))
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId   String
  product     Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  amountCents Int
  currency    String        @default("USD")
  status      PaymentStatus @default(PENDING)
  providerRef String?
  createdAt   DateTime      @default(now())

  @@index([userId])
}

model Order {
  id         String      @id @default(cuid(2))
  userId     String
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  items      Json
  totalCents Int
  status     OrderStatus @default(PENDING)
  createdAt  DateTime    @default(now())

  @@index([userId])
}

model Boost {
  id        String      @id @default(cuid(2))
  projectId String
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  productId String
  product   Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  startsAt  DateTime    @default(now())
  endsAt    DateTime
  status    BoostStatus @default(ACTIVE)
  createdAt DateTime    @default(now())

  @@index([endsAt])
  @@index([projectId])
}

model FeaturedProject {
  id        String            @id @default(cuid(2))
  projectId String
  project   Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  placement FeaturedPlacement
  startsAt  DateTime          @default(now())
  endsAt    DateTime
  createdAt DateTime          @default(now())

  @@index([placement, startsAt, endsAt])
  @@index([projectId])
}

model AdminAction {
  id         String          @id @default(cuid(2))
  adminId    String
  admin      User            @relation(fields: [adminId], references: [id], onDelete: Cascade)
  action     AdminActionType
  targetType String
  targetId   String
  detail     String?         @db.Text
  createdAt  DateTime        @default(now())

  @@index([adminId])
  @@index([targetType, targetId])
  @@index([createdAt])
}

model SystemSetting {
  id          String   @id @default(cuid(2))
  key         String   @unique
  value       String   @db.Text
  description String?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@index([key])
}

